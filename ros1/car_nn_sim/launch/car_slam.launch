<launch>
  <!-- Mapping + localisation: lidar scan matching builds /map while driving. -->
  <arg name="scene" default="day"/>
  <arg name="policy" default=""/>
  <arg name="rviz" default="true"/>

  <node pkg="car_nn_sim" type="sim_node.py" name="car_nn_sim" output="screen">
    <param name="scene" value="$(arg scene)"/>
    <param name="policy" value="$(arg policy)"/>
    <param name="rate" value="20.0"/>
  </node>

  <node pkg="car_nn_sim" type="slam_node.py" name="car_slam" output="screen">
    <param name="publish_rate" value="1.0"/>
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"/>
</launch>
