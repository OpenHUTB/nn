{"config":{"lang":["zh"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u57fa\u4e8eCARLA\u7684\u81ea\u52a8\u9a7e\u9a76\u53ef\u89c6\u5316\u76d1\u63a7\u7cfb\u7edf","text":"<p>\u672c\u9879\u76ee\u57fa\u4e8e CARLA \u6a21\u62df\u5668\u6784\u5efa\uff0c\u4e3a\u81ea\u52a8\u9a7e\u9a76\u8f66\u8f86\u63d0\u4f9b\u4e00\u7ad9\u5f0f\u5b9e\u65f6\u76d1\u63a7\u4e0e\u53ef\u89c6\u5316 HUD\uff08Head-Up Display\uff09\u89e3\u51b3\u65b9\u6848\u3002</p>"},{"location":"#_1","title":"\u6838\u5fc3\u529f\u80fd","text":""},{"location":"#_2","title":"\u5b9e\u65f6\u89c6\u89c9\u76d1\u63a7","text":"<ul> <li>\u524d\u7f6e RGB \u6444\u50cf\u5934\uff0c640\u00d7480 \u5206\u8fa8\u7387\uff0c\u5b89\u88c5\u4e8e\u8f66\u8f86\u524d\u65b9 2.5m\u3001\u9ad8\u5ea6 1.5m \u5904</li> <li>\u57fa\u4e8e CARLA \u540c\u6b65\u6a21\u5f0f\uff08<code>fixed_delta_seconds = 0.05</code>\uff09\uff0c\u5e27\u7387\u7a33\u5b9a\u5728 20 FPS</li> <li>\u6444\u50cf\u5934\u6570\u636e\u901a\u8fc7 <code>listen(callback)</code> \u5f02\u6b65\u56de\u8c03\uff0c\u7ecf NumPy \u89e3\u7801\u540e\u7531 OpenCV \u6e32\u67d3</li> </ul>"},{"location":"#_3","title":"\u8f66\u8f86\u72b6\u6001\u76d1\u63a7","text":"<ul> <li>\u5b9e\u65f6\u8ba1\u7b97\u5e76\u663e\u793a\u884c\u9a76\u901f\u5ea6\uff08\u7531 <code>get_velocity()</code> \u4e09\u8f74\u5206\u91cf\u5408\u6210\uff0c\u8f6c\u6362\u4e3a km/h\uff09</li> <li>\u53ef\u8c03\u8282\u8d85\u901f\u9608\u503c\uff08\u9ed8\u8ba4 60 km/h\uff0c\u6700\u4f4e 10 km/h\uff09\uff0c\u8d85\u901f\u65f6\u901f\u5ea6\u6570\u5b57\u53d8\u7ea2</li> <li>\u901f\u5ea6\u8b66\u544a\u53ef\u72ec\u7acb\u5f00\u5173\uff08<code>W/w</code> \u952e\uff09</li> </ul>"},{"location":"#_4","title":"\u591a\u89c6\u89d2\u81ea\u7531\u5207\u6362","text":"<p>\u652f\u6301 5 \u79cd\u89c6\u89d2\u6a21\u5f0f\uff0c\u5927\u5c0f\u5199\u4e0d\u654f\u611f\uff1a</p> \u6309\u952e \u89c6\u89d2\u6a21\u5f0f \u5b9e\u73b0\u65b9\u5f0f <code>T/t</code> \u4fef\u89c6\u89c6\u89d2 \u8f66\u8f86\u4e0a\u65b9 50m\uff0c\u4fef\u89d2 -90\u00b0 <code>F/f</code> \u8ddf\u968f\u89c6\u89d2 \u540e\u65b9 5m\u3001\u4e0a\u65b9 3m\uff0c\u4fef\u89d2 -15\u00b0 <code>C/c</code> \u8ffd\u9010\u89c6\u89d2 \u540e\u65b9 5m\u3001\u4e0a\u65b9 2m\uff0c\u4fef\u89d2 -10\u00b0 <code>S/s</code> \u4fa7\u89c6\u89c6\u89d2 \u4fa7\u65b9 5m\u3001\u4e0a\u65b9 3m\uff0c\u504f\u822a +90\u00b0 <code>X/x</code> \u8fd1\u8ddd\u79bb\u89c6\u89d2 \u540e\u65b9 5m\u3001\u4e0a\u65b9 4m\uff0c\u4fef\u89d2 -25\u00b0 <p>\u6240\u6709\u89c6\u89d2\u901a\u8fc7 <code>world.get_spectator().set_transform()</code> \u5b9e\u65f6\u66f4\u65b0\uff0c\u8ddf\u968f\u8f66\u8f86\u4f4d\u7f6e\u4e0e\u671d\u5411\u3002</p>"},{"location":"#_5","title":"\u667a\u80fd\u5bfc\u822a\u7cfb\u7edf","text":"<ul> <li>\u4ece\u5730\u56fe\u751f\u6210\u70b9\u4e2d\u968f\u673a\u9009\u53d6\u8ddd\u79bb\u5f53\u524d\u4f4d\u7f6e &gt; 50m \u7684\u76ee\u7684\u5730</li> <li>HUD \u9762\u677f\u663e\u793a\u5bfc\u822a\u5f00\u5173\u72b6\u6001</li> <li>\u6309 <code>N/n</code> \u952e\u91cd\u65b0\u968f\u673a\u9009\u62e9\u5bfc\u822a\u76ee\u7684\u5730</li> </ul>"},{"location":"#_6","title":"\u73af\u5883\u6a21\u62df\u7cfb\u7edf","text":"<p>5 \u79cd\u5929\u6c14\u6a21\u5f0f\uff0c\u6bcf\u79cd\u5929\u6c14\u6709\u72ec\u7acb\u7684\u7269\u7406\u53c2\u6570\u914d\u7f6e\uff1a</p> \u5929\u6c14 \u4e91\u91cf \u964d\u6c34 \u96fe\u5bc6\u5ea6 \u6674\u5929 Clear 0 0 0 \u591a\u4e91 Cloudy 80 0 20 \u96e8\u5929 Rain 100 80 30 \u96fe\u5929 Fog 90 20 60 \u96ea\u5929 Snow 100 100 40 <ul> <li>24 \u5c0f\u65f6\u65f6\u95f4\u7cfb\u7edf\uff1a\u592a\u9633\u9ad8\u5ea6\u89d2 = <code>(hour - 6) \u00d7 15\u00b0</code></li> <li><code>V/v</code> \u5faa\u73af\u5207\u6362\u5929\u6c14\uff0c<code>U/u</code> \u6bcf\u6b21\u589e\u52a0 3 \u5c0f\u65f6</li> </ul>"},{"location":"#_7","title":"\u81ea\u52a8\u6cca\u8f66\u529f\u80fd","text":"<p>6 \u9636\u6bb5\u4fa7\u65b9\u4f4d\u505c\u8f66\u72b6\u6001\u673a\uff1a</p> \u9636\u6bb5 \u64cd\u4f5c \u89e6\u53d1\u6761\u4ef6 0 \u5168\u529b\u5236\u52a8 \u542f\u52a8\u6cca\u8f66 1 \u6cb9\u95e8 0.4 + \u5de6\u6ee1\u8235 \u9636\u6bb5 0 \u5b8c\u6210 2 \u5168\u529b\u5236\u52a8 \u8f66\u901f &gt; 2 m/s 3 \u6cb9\u95e8 0.4 + \u53f3\u6ee1\u8235 + \u5012\u6863 \u9636\u6bb5 2 \u5b8c\u6210 4 \u6cb9\u95e8 0.3 + \u5012\u6863 \u9636\u6bb5 3 \u5b8c\u6210 5 \u5236\u52a8\u505c\u8f66\uff0c\u6062\u590d\u81ea\u52a8\u9a7e\u9a76 \u9636\u6bb5 4 \u5b8c\u6210 <p>\u6309 <code>P/p</code> \u952e\u542f\u52a8\uff0c\u6cca\u8f66\u671f\u95f4\u7981\u7528\u81ea\u52a8\u9a7e\u9a76\uff0c\u5b8c\u6210\u540e\u81ea\u52a8\u6062\u590d\u3002</p>"},{"location":"#_8","title":"\u591a\u8f66\u578b\u5207\u6362","text":"<p>\u652f\u6301 5 \u79cd\u8f66\u578b\uff08\u5207\u6362\u540e\u4fdd\u6301\u5f53\u524d\u4f4d\u7f6e\uff09\uff1a</p> <ul> <li><code>vehicle.tesla.model3</code> \u2014 Tesla Model 3</li> <li><code>vehicle.mercedes.coupe</code> \u2014 Mercedes Coupe</li> <li><code>vehicle.audi.a2</code> \u2014 Audi A2</li> <li><code>vehicle.bmw.isetta</code> \u2014 BMW Isetta</li> <li><code>vehicle.ford.crown</code> \u2014 Ford Crown</li> </ul> <p>\u6309 <code>K/k</code> \u952e\u987a\u5e8f\u5207\u6362\u3002</p>"},{"location":"#_9","title":"\u884c\u9a76\u8f68\u8ff9\u56de\u653e","text":"<ul> <li>\u5b9e\u65f6\u8bb0\u5f55\u8f66\u8f86\u4f4d\u7f6e\u81f3\u8f68\u8ff9\u70b9\u961f\u5217\uff0c\u6700\u5927\u5bb9\u91cf 200 \u4e2a\u70b9</li> <li>\u8d85\u8fc7\u4e0a\u9650\u65f6\u79fb\u9664\u6700\u65e7\u7684\u70b9\uff08FIFO \u961f\u5217\uff09</li> <li>\u4e16\u754c\u5750\u6807 \u2192 \u56fe\u50cf\u5750\u6807\u8f6c\u6362\uff1a<code>img_x = 320 + (world_x - current_x) \u00d7 5</code></li> <li>\u6e10\u53d8\u8272\u7ed8\u5236\uff1a\u84dd\u8272\uff08\u6700\u65b0\uff09\u2192 \u7eff\u8272\uff08\u4e2d\u95f4\uff09\u2192 \u7ea2\u8272\uff08\u6700\u65e7\uff09</li> <li>\u4ec5\u5728\u753b\u9762\u8303\u56f4\u5185\uff080-640, 0-480\uff09\u7ed8\u5236\u7ebf\u6bb5</li> <li>\u6309 <code>R/r</code> \u952e\u91cd\u7f6e\u8f68\u8ff9</li> </ul>"},{"location":"#_10","title":"\u5feb\u901f\u5f00\u59cb","text":""},{"location":"#_11","title":"\u73af\u5883\u51c6\u5907","text":"<ul> <li>CARLA Simulator 0.9.14+</li> <li>Python 3.7+</li> <li>\u4f9d\u8d56\u5b89\u88c5\uff1a</li> </ul> <pre><code>pip install opencv-python numpy\n</code></pre>"},{"location":"#_12","title":"\u8fd0\u884c\u6b65\u9aa4","text":"<ol> <li>\u542f\u52a8 CARLA \u6a21\u62df\u5668\uff08\u9700\u5148\u5b89\u88c5 CARLA\uff09\uff1a</li> </ol> <pre><code>CarlaUE4.exe\n</code></pre> <ol> <li>\u8fd0\u884c\u4e3b\u7a0b\u5e8f\uff1a</li> </ol> <pre><code>python main.py\n</code></pre> <ol> <li>\u7a0b\u5e8f\u542f\u52a8\u540e\u81ea\u52a8\u5728\u968f\u673a\u4f4d\u7f6e\u751f\u6210 Tesla Model 3 \u5e76\u5f00\u542f\u81ea\u52a8\u9a7e\u9a76\uff0cHUD \u7a97\u53e3\u663e\u793a\u5b9e\u65f6\u753b\u9762\u3002</li> </ol>"},{"location":"#_13","title":"\u5feb\u6377\u952e\u6c47\u603b","text":"\u6309\u952e \u529f\u80fd <code>T</code> / <code>t</code> \u5207\u6362\u5230\u4fef\u89c6\u89c6\u89d2 <code>F</code> / <code>f</code> \u5207\u6362\u5230\u8ddf\u968f\u89c6\u89d2 <code>C</code> / <code>c</code> \u5207\u6362\u5230\u8ffd\u9010\u89c6\u89d2 <code>S</code> / <code>s</code> \u5207\u6362\u5230\u4fa7\u89c6\u89c6\u89d2 <code>X</code> / <code>x</code> \u5207\u6362\u5230\u8fd1\u8ddd\u79bb\u89c6\u89d2 <code>K</code> / <code>k</code> \u5207\u6362\u8f66\u8f86\u7c7b\u578b <code>P</code> / <code>p</code> \u542f\u52a8\u81ea\u52a8\u6cca\u8f66 <code>V</code> / <code>v</code> \u5207\u6362\u5929\u6c14\u6a21\u5f0f\uff08\u5faa\u73af 5 \u79cd\uff09 <code>U</code> / <code>u</code> \u5207\u6362\u65f6\u95f4\uff08\u6bcf\u6b21 +3 \u5c0f\u65f6\uff09 <code>N</code> / <code>n</code> \u8bbe\u7f6e/\u91cd\u7f6e\u5bfc\u822a\u76ee\u7684\u5730 <code>W</code> / <code>w</code> \u5f00\u5173\u901f\u5ea6\u8b66\u544a <code>R</code> / <code>r</code> \u91cd\u7f6e\u884c\u9a76\u8f68\u8ff9 <code>+</code> / <code>-</code> \u8c03\u6574\u9650\u901f\u9608\u503c\uff08\u00b110 km/h\uff09 <code>ESC</code> \u9000\u51fa\u7a0b\u5e8f"},{"location":"#_14","title":"\u9879\u76ee\u7ed3\u6784","text":"<pre><code>vehicle_HUD/\n\u251c\u2500\u2500 main.py          # \u4e3b\u7a0b\u5e8f\u5165\u53e3\uff08\u5168\u90e8\u6838\u5fc3\u903b\u8f91\uff09\n\u2514\u2500\u2500 README.md        # \u9879\u76ee\u8bf4\u660e\u6587\u6863\n</code></pre>"},{"location":"#_15","title":"\u6280\u672f\u6808","text":"\u7ec4\u4ef6 \u6280\u672f \u7528\u9014 \u6a21\u62df\u5f15\u64ce CARLA Simulator 0.9.14+ \u8f66\u8f86\u7269\u7406\u3001\u4f20\u611f\u5668\u3001\u73af\u5883\u6a21\u62df \u7f16\u7a0b\u8bed\u8a00 Python 3.7+ \u6574\u4f53\u903b\u8f91\u5b9e\u73b0 \u56fe\u50cf\u5904\u7406 OpenCV (<code>cv2</code>) \u753b\u9762\u6e32\u67d3\u3001\u8f68\u8ff9\u7ed8\u5236\u3001HUD \u6587\u5b57\u53e0\u52a0 \u6570\u503c\u8ba1\u7b97 NumPy \u6444\u50cf\u5934\u539f\u59cb\u6570\u636e\u89e3\u7801\u4e0e\u6570\u7ec4\u91cd\u5851"},{"location":"#_16","title":"\u5e38\u89c1\u95ee\u9898","text":"<p>\u753b\u9762\u5361\u987f</p> <p>\u68c0\u67e5 CARLA \u6a21\u62df\u5668\u8d44\u6e90\u5360\u7528\uff0c\u53ef\u5c1d\u8bd5\u964d\u4f4e\u6444\u50cf\u5934\u5206\u8fa8\u7387\uff08\u4fee\u6539 <code>image_size_x</code> / <code>image_size_y</code> \u5c5e\u6027\uff09\uff0c\u6216\u589e\u5927 <code>fixed_delta_seconds</code> \u964d\u4f4e\u5e27\u7387\u3002</p> <p>\u89c6\u89d2\u5207\u6362\u65e0\u54cd\u5e94</p> <p>\u786e\u8ba4\u952e\u76d8\u7126\u70b9\u5728 OpenCV \u7a97\u53e3\u4e2d\uff08\u7a97\u53e3\u6807\u9898 \"HUD\"\uff09\uff0c\u6309\u952e\u5224\u65ad\u4f7f\u7528 <code>cv2.waitKey()</code>\uff0c\u5927\u5c0f\u5199\u5747\u652f\u6301\u3002</p> <p>\u81ea\u52a8\u6cca\u8f66\u5931\u8d25</p> <p>\u786e\u4fdd\u8f66\u8f86\u5df2\u5b8c\u5168\u505c\u6b62\uff08\u6cca\u8f66\u9636\u6bb5 0 \u5148\u6267\u884c\u5236\u52a8\uff09\uff0c\u4e14\u6cca\u8f66\u533a\u57df\u5468\u56f4\u65e0\u969c\u788d\u7269\u963b\u6321\u3002</p> <p>\u5bfc\u822a\u4e0d\u751f\u6210</p> <p>\u786e\u8ba4 CARLA \u5730\u56fe\u5df2\u5b8c\u5168\u52a0\u8f7d\uff0c\u4e14\u8f66\u8f86\u5f53\u524d\u4f4d\u7f6e\u5468\u56f4\u5b58\u5728\u8ddd\u79bb &gt; 50m \u7684\u751f\u6210\u70b9\u3002\u5982\u6240\u6709\u751f\u6210\u70b9\u5747 \u2264 50m\uff0c\u4e0d\u4f1a\u751f\u6210\u5bfc\u822a\u3002</p> <p>\u8fde\u63a5 CARLA \u8d85\u65f6</p> <p>\u786e\u8ba4 CARLA \u6a21\u62df\u5668\u5df2\u5728 <code>localhost:2000</code> \u8fd0\u884c\u3002\u7a0b\u5e8f\u8fde\u63a5\u8d85\u65f6\u8bbe\u7f6e\u4e3a 20 \u79d2\uff0c\u8d85\u65f6\u672a\u8fde\u63a5\u5c06\u629b\u51fa\u5f02\u5e38\u3002</p> <p>\u672c\u9879\u76ee\u6301\u7eed\u7ef4\u62a4\u4e2d\u3002\u5982\u9700\u6269\u5c55\u529f\u80fd\uff0c\u53ef\u4fee\u6539 <code>main.py</code> \u4e2d\u7684\u5bf9\u5e94\u903b\u8f91\u6a21\u5757\u3002</p>"},{"location":"architecture/","title":"\u7cfb\u7edf\u67b6\u6784","text":""},{"location":"architecture/#_2","title":"\u6574\u4f53\u67b6\u6784","text":"<pre><code>\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\n\u2502                  main.py                      \u2502\n\u2502                                               \u2502\n\u2502  \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510  \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510  \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510  \u2502\n\u2502  \u2502 CARLA    \u2502  \u2502 \u6444\u50cf\u5934   \u2502  \u2502 OpenCV HUD \u2502  \u2502\n\u2502  \u2502 Client   \u2502  \u2502 Pipeline \u2502  \u2502 \u6e32\u67d3\u5f15\u64ce   \u2502  \u2502\n\u2502  \u2514\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2518  \u2514\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2518  \u2514\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2518  \u2502\n\u2502       \u2502              \u2502               \u2502         \u2502\n\u2502  \u250c\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2510 \u2502\n\u2502  \u2502              \u4e3b\u5faa\u73af (while True)          \u2502 \u2502\n\u2502  \u2502  world.tick() \u2192 \u66f4\u65b0\u89c6\u89d2 \u2192 \u66f4\u65b0\u6cca\u8f66 \u2192    \u2502 \u2502\n\u2502  \u2502  \u66f4\u65b0\u8f68\u8ff9 \u2192 \u6e32\u67d3HUD \u2192 \u5904\u7406\u6309\u952e           \u2502 \u2502\n\u2502  \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518 \u2502\n\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\n</code></pre>"},{"location":"architecture/#carla","title":"CARLA \u540c\u6b65\u6a21\u5f0f","text":"<p>\u7a0b\u5e8f\u91c7\u7528 CARLA \u7684 \u540c\u6b65\u6a21\u5f0f\uff08Synchronous Mode\uff09\uff0c\u4fdd\u8bc1\u4eff\u771f\u4e0e\u6e32\u67d3\u6b65\u8c03\u4e00\u81f4\uff1a</p> <pre><code>settings = world.get_settings()\nsettings.synchronous_mode = True\nsettings.fixed_delta_seconds = 0.05  # 20 FPS\nworld.apply_settings(settings)\n</code></pre> <p>\u4e3b\u5faa\u73af\u4e2d\u6bcf\u5e27\u8c03\u7528 <code>world.tick()</code> \u63a8\u8fdb\u4eff\u771f\u4e00\u6b65\u3002\u9000\u51fa\u65f6\u6062\u590d\u5f02\u6b65\u6a21\u5f0f\u907f\u514d\u963b\u585e\u6a21\u62df\u5668\u3002</p>"},{"location":"architecture/#_3","title":"\u6444\u50cf\u5934\u7ba1\u7ebf","text":"<pre><code>CARLA \u6444\u50cf\u5934\u4f20\u611f\u5668\n       \u2502\n       \u25bc (raw_data: BGRA uint8 \u6570\u7ec4)\n  NumPy \u89e3\u7801\n       \u2502\n       \u25bc (reshape \u2192 (480, 640, 4) \u2192 [:,:,:3])\n  BGR \u56fe\u50cf (480\u00d7640\u00d73)\n       \u2502\n       \u25bc\n  OpenCV \u53e0\u52a0 HUD \u4fe1\u606f\n       \u2502\n       \u25bc\n  cv2.imshow(\"HUD\", frame)\n</code></pre> <ul> <li>\u6444\u50cf\u5934\u84dd\u56fe\uff1a<code>sensor.camera.rgb</code></li> <li>\u5b89\u88c5\u4f4d\u7f6e\uff1a<code>carla.Location(x=2.5, z=1.5)</code> \u2014 \u8f66\u8f86\u524d\u65b9 2.5m\uff0c\u9ad8\u5ea6 1.5m</li> <li>\u901a\u8fc7 <code>camera.listen(callback)</code> \u5f02\u6b65\u63a5\u6536\u6570\u636e</li> <li><code>images['front']</code> \u5b57\u5178\u5b58\u50a8\u6700\u65b0\u4e00\u5e27</li> </ul>"},{"location":"architecture/#_4","title":"\u89c6\u89d2\u7cfb\u7edf","text":"<p>5 \u79cd\u89c6\u89d2\u901a\u8fc7\u64cd\u4f5c Spectator\uff08\u89c2\u5bdf\u8005\uff09\u7684 Transform \u5b9e\u73b0\uff1a</p> \u89c6\u89d2 Location \u504f\u79fb Rotation top <code>+ Location(z=50)</code> <code>pitch=-90</code> follow <code>+ Location(x=-5, z=3)</code> <code>pitch=-15</code> (\u8ddf\u968f\u8f66\u8f86 yaw) chase <code>+ Location(x=-5, z=2)</code> <code>pitch=-10</code> (\u8ddf\u968f\u8f66\u8f86 yaw) side <code>+ Location(y=5, z=3)</code> <code>pitch=-15, yaw+90</code> close <code>+ Location(x=-5, z=4)</code> <code>pitch=-25</code> (\u8ddf\u968f\u8f66\u8f86 yaw) <p>\u6240\u6709\u504f\u79fb\u57fa\u4e8e\u8f66\u8f86\u5f53\u524d Transform \u8ba1\u7b97\uff0cSpectator \u901a\u8fc7 <code>world.get_spectator().set_transform()</code> \u66f4\u65b0\u3002</p>"},{"location":"architecture/#_5","title":"\u8f68\u8ff9\u6e32\u67d3\u7cfb\u7edf","text":""},{"location":"architecture/#_6","title":"\u6570\u636e\u91c7\u96c6","text":"<pre><code>trail_points = []            # \u8f68\u8ff9\u70b9\u961f\u5217\nmax_trail_length = 200       # \u6700\u5927\u5bb9\u91cf\n</code></pre> <p>\u6bcf\u5e27\u5c06\u8f66\u8f86\u5f53\u524d\u4f4d\u7f6e <code>(x, y)</code> \u8ffd\u52a0\u5230\u961f\u5217\uff0c\u8d85\u51fa\u4e0a\u9650\u65f6\u4ece\u961f\u9996\u79fb\u9664\uff08FIFO\uff09\u3002</p>"},{"location":"architecture/#_7","title":"\u5750\u6807\u8f6c\u6362","text":"<p>\u4e16\u754c\u5750\u6807 \u2192 \u56fe\u50cf\u5750\u6807\u7684\u7b80\u5316\u6620\u5c04\uff1a</p> <pre><code>img_x = 320 + (world_x - current_x) \u00d7 5\nimg_y = 240 + (world_y - current_y) \u00d7 5\n</code></pre> <p>\u4ee5\u753b\u9762\u4e2d\u5fc3 (320, 240) \u4e3a\u57fa\u51c6\uff0c\u7f29\u653e\u56e0\u5b50 5 \u63a7\u5236\u8f68\u8ff9\u663e\u793a\u8303\u56f4\u3002\u4ec5\u7ed8\u5236\u5728\u753b\u9762\u8303\u56f4\u5185\u7684\u7ebf\u6bb5\u3002</p>"},{"location":"architecture/#_8","title":"\u989c\u8272\u6e10\u53d8","text":"<pre><code>def get_color_by_time(index, total):\n    ratio = index / total        # 0.0(\u6700\u65e7) \u2192 1.0(\u6700\u65b0)\n    r = int(255 * ratio)         # \u65e7\u2192\u7ea2: 0\u2192255\n    g = int(100 * (1 - ratio))   # \u8fc7\u6e21\u7eff\n    b = int(255 * (1 - ratio))   # \u65b0\u2192\u84dd: 255\u21920\n    return (b, g, r)             # OpenCV BGR \u683c\u5f0f\n</code></pre> <p>\u6e10\u53d8\u6548\u679c\uff1a\u84dd\u8272\uff08\u6700\u65b0\u8f68\u8ff9\uff09\u2192 \u7d2b\u8272 \u2192 \u7ea2\u8272\uff08\u6700\u65e7\u8f68\u8ff9\uff09\u3002</p>"},{"location":"architecture/#_9","title":"\u5929\u6c14\u7cfb\u7edf","text":"<p>5 \u79cd\u5929\u6c14\u6a21\u5f0f\u7531 <code>carla.WeatherParameters</code> \u7684 3 \u4e2a\u6838\u5fc3\u53c2\u6570\u63a7\u5236\uff1a</p> <pre><code># \u6674\u5929: cloudiness=0,  precipitation=0,  fog_density=0\n# \u591a\u4e91: cloudiness=80, precipitation=0,  fog_density=20\n# \u96e8\u5929: cloudiness=100, precipitation=80, fog_density=30\n# \u96fe\u5929: cloudiness=90, precipitation=20, fog_density=60\n# \u96ea\u5929: cloudiness=100, precipitation=100,fog_density=40\n</code></pre> <p>\u592a\u9633\u9ad8\u5ea6\u89d2\u8ba1\u7b97\u516c\u5f0f\uff1a<code>sun_altitude_angle = (current_hour - 6) \u00d7 15</code></p> <ul> <li>6:00 \u2192 0\u00b0\uff08\u65e5\u51fa\uff09</li> <li>12:00 \u2192 90\u00b0\uff08\u6b63\u5348\uff09</li> <li>18:00 \u2192 180\u00b0\uff08\u65e5\u843d\uff09</li> <li>0:00 \u2192 -90\u00b0\uff08\u6df1\u591c\uff09</li> </ul>"},{"location":"architecture/#_10","title":"\u6cca\u8f66\u72b6\u6001\u673a","text":"<p>\u81ea\u52a8\u6cca\u8f66\u7531 6 \u9636\u6bb5\u6709\u9650\u72b6\u6001\u673a\u9a71\u52a8\uff0c\u6bcf\u5e27\u6267\u884c\u5f53\u524d\u9636\u6bb5\u64cd\u4f5c\uff1a</p> <pre><code>  [P\u952e\u89e6\u53d1]\n      \u2502\n      \u25bc\n  \u9636\u6bb50: \u5236\u52a8 1.0 \u2500\u2500\u2192 \u9636\u6bb51: \u524d\u8fdb\u5de6\u8f6c \u2500\u2500\u2192 \u9636\u6bb52: \u5236\u52a8 1.0\n                                                      \u2502\n                                                      \u25bc\n  \u9636\u6bb55: \u5236\u52a8+\u6062\u590dAP \u2190\u2500\u2500 \u9636\u6bb54: \u5012\u8f66\u76f4\u884c \u2190\u2500\u2500 \u9636\u6bb53: \u5012\u8f66\u53f3\u8f6c\n</code></pre> <ul> <li>\u89e6\u53d1\u65f6 <code>vehicle.set_autopilot(False)</code> \u7981\u7528\u81ea\u52a8\u9a7e\u9a76</li> <li>\u9636\u6bb5 5 \u5b8c\u6210\u540e\u6062\u590d <code>vehicle.set_autopilot(True)</code></li> </ul>"},{"location":"architecture/#_11","title":"\u8f66\u8f86\u5207\u6362","text":"<p>\u5207\u6362\u8f66\u8f86\u7c7b\u578b\u65f6\u9500\u6bc1\u65e7\u8f66\u8f86\u5e76\u5728\u76f8\u540c\u4f4d\u7f6e\u751f\u6210\u65b0\u8f66\u8f86\u3002CARLA \u8f66\u8f86\u84dd\u56fe ID\uff1a</p> <pre><code>vehicle.tesla.model3    \u2192 vehicle.mercedes.coupe  \u2192 vehicle.audi.a2\n\u2192 vehicle.bmw.isetta    \u2192 vehicle.ford.crown      \u2192 (\u5faa\u73af)\n</code></pre>"},{"location":"architecture/#_12","title":"\u8d44\u6e90\u6e05\u7406","text":"<p>\u7a0b\u5e8f\u9000\u51fa\uff08ESC \u6216\u5173\u95ed\u7a97\u53e3\uff09\u65f6\u6267\u884c <code>finally</code> \u5757\uff1a</p> <pre><code>finally:\n    settings.synchronous_mode = False  # \u6062\u590d\u5f02\u6b65\u6a21\u5f0f\n    world.apply_settings(settings)\n    camera.destroy()                   # \u9500\u6bc1\u6444\u50cf\u5934\n    vehicle.destroy()                  # \u9500\u6bc1\u8f66\u8f86\n    cv2.destroyAllWindows()            # \u5173\u95ed OpenCV \u7a97\u53e3\n</code></pre>"},{"location":"quickstart/","title":"\u5feb\u901f\u5f00\u59cb","text":""},{"location":"quickstart/#_2","title":"\u73af\u5883\u8981\u6c42","text":"\u4f9d\u8d56 \u7248\u672c\u8981\u6c42 \u8bf4\u660e CARLA Simulator 0.9.14 \u6216\u66f4\u9ad8 \u81ea\u52a8\u9a7e\u9a76\u6a21\u62df\u5f15\u64ce Python 3.7 \u6216\u66f4\u9ad8 \u4e3b\u7a0b\u5e8f\u8fd0\u884c\u73af\u5883 OpenCV \u6700\u65b0\u7a33\u5b9a\u7248 \u56fe\u50cf\u6e32\u67d3\u4e0e HUD \u663e\u793a NumPy \u6700\u65b0\u7a33\u5b9a\u7248 \u6444\u50cf\u5934\u539f\u59cb\u6570\u636e\u89e3\u7801"},{"location":"quickstart/#_3","title":"\u5b89\u88c5\u6b65\u9aa4","text":""},{"location":"quickstart/#1-carla","title":"1. \u5b89\u88c5 CARLA","text":"<p>\u4ece CARLA \u5b98\u65b9 GitHub \u4e0b\u8f7d\u5bf9\u5e94\u5e73\u53f0\u7684\u7248\u672c\uff0c\u89e3\u538b\u5230\u672c\u5730\u76ee\u5f55\u3002</p>"},{"location":"quickstart/#2-python","title":"2. \u5b89\u88c5 Python \u4f9d\u8d56","text":"<pre><code>pip install opencv-python numpy\n</code></pre> <p>\u5982\u9700\u4f7f\u7528\u6e05\u534e\u955c\u50cf\u52a0\u901f\uff1a</p> <pre><code>pip install opencv-python numpy -i https://pypi.tuna.tsinghua.edu.cn/simple\n</code></pre>"},{"location":"quickstart/#3","title":"3. \u83b7\u53d6\u9879\u76ee\u4ee3\u7801","text":"<p>\u5c06 <code>vehicle_HUD/</code> \u76ee\u5f55\u590d\u5236\u5230\u672c\u5730\u4efb\u610f\u4f4d\u7f6e\u3002</p>"},{"location":"quickstart/#_4","title":"\u8fd0\u884c\u7a0b\u5e8f","text":""},{"location":"quickstart/#carla","title":"\u7b2c\u4e00\u6b65\uff1a\u542f\u52a8 CARLA \u6a21\u62df\u5668","text":"<p>\u8fdb\u5165 CARLA \u5b89\u88c5\u76ee\u5f55\uff0c\u542f\u52a8\u6a21\u62df\u5668\uff1a</p> <pre><code># Windows\nCarlaUE4.exe\n\n# Linux\n./CarlaUE4.sh\n</code></pre> <p>\u6a21\u62df\u5668\u542f\u52a8\u540e\u9ed8\u8ba4\u76d1\u542c <code>localhost:2000</code>\u3002</p>"},{"location":"quickstart/#hud","title":"\u7b2c\u4e8c\u6b65\uff1a\u8fd0\u884c HUD \u4e3b\u7a0b\u5e8f","text":"<p>\u5728\u53e6\u4e00\u4e2a\u7ec8\u7aef\u4e2d\u8fdb\u5165 <code>vehicle_HUD/</code> \u76ee\u5f55\uff1a</p> <pre><code>cd vehicle_HUD\npython main.py\n</code></pre> <p>\u7a0b\u5e8f\u542f\u52a8\u540e\uff1a 1. \u81ea\u52a8\u8fde\u63a5 CARLA\uff08\u8d85\u65f6 20 \u79d2\uff09 2. \u5728\u968f\u673a\u751f\u6210\u70b9\u521b\u5efa Tesla Model 3 3. \u5f00\u542f\u81ea\u52a8\u9a7e\u9a76\u6a21\u5f0f 4. \u5f39\u51fa HUD \u53ef\u89c6\u5316\u7a97\u53e3\uff0c\u663e\u793a\u5b9e\u65f6\u753b\u9762\u4e0e\u72b6\u6001\u4fe1\u606f</p>"},{"location":"quickstart/#_5","title":"\u64cd\u4f5c\u6307\u5357","text":"<p>\u7a0b\u5e8f\u901a\u8fc7\u952e\u76d8\u63a7\u5236\uff0c\u6240\u6709\u529f\u80fd\u952e\u5927\u5c0f\u5199\u4e0d\u654f\u611f\uff1a</p> \u7c7b\u522b \u6309\u952e \u529f\u80fd \u89c6\u89d2 <code>T</code> <code>F</code> <code>C</code> <code>S</code> <code>X</code> 5 \u79cd\u89c6\u89d2\u5207\u6362 \u8f66\u8f86 <code>K</code> \u5faa\u73af\u5207\u6362\u8f66\u578b \u6cca\u8f66 <code>P</code> \u542f\u52a8\u81ea\u52a8\u6cca\u8f66 \u5929\u6c14 <code>V</code> \u5faa\u73af\u5207\u6362\u5929\u6c14 \u65f6\u95f4 <code>U</code> \u5207\u6362\u65f6\u95f4\uff08+3 \u5c0f\u65f6\uff09 \u5bfc\u822a <code>N</code> \u8bbe\u7f6e/\u91cd\u7f6e\u968f\u673a\u76ee\u7684\u5730 \u9650\u901f <code>+</code> <code>-</code> \u8c03\u6574\u8d85\u901f\u9608\u503c \u8b66\u544a <code>W</code> \u5f00\u5173\u901f\u5ea6\u8b66\u544a \u8f68\u8ff9 <code>R</code> \u91cd\u7f6e\u884c\u9a76\u8f68\u8ff9 \u9000\u51fa <code>ESC</code> \u9000\u51fa\u7a0b\u5e8f"},{"location":"quickstart/#_6","title":"\u9000\u51fa\u7a0b\u5e8f","text":"<p>\u6309 <code>ESC</code> \u952e\u6216\u5173\u95ed HUD \u7a97\u53e3\u5373\u53ef\u9000\u51fa\u3002\u7a0b\u5e8f\u4f1a\u81ea\u52a8\u6267\u884c\u8d44\u6e90\u6e05\u7406\uff1a</p> <ul> <li>\u6062\u590d CARLA \u5f02\u6b65\u6a21\u5f0f</li> <li>\u9500\u6bc1\u6444\u50cf\u5934\u4e0e\u8f66\u8f86 Actor</li> <li>\u5173\u95ed\u6240\u6709 OpenCV \u7a97\u53e3</li> </ul>"},{"location":"quickstart/#_7","title":"\u5e38\u89c1\u542f\u52a8\u95ee\u9898","text":"<p>\"\u8fde\u63a5\u8d85\u65f6\" \u9519\u8bef</p> <p>\u786e\u8ba4 CARLA \u6a21\u62df\u5668\u5df2\u5b8c\u5168\u542f\u52a8\u4e14\u76d1\u542c\u5728 <code>localhost:2000</code>\u3002\u53ef\u5728\u6a21\u62df\u5668\u7a97\u53e3\u770b\u5230 3D \u573a\u666f\u5373\u8868\u793a\u5c31\u7eea\u3002</p> <p>ImportError: No module named 'carla'</p> <p>\u9700\u8981\u5b89\u88c5 CARLA Python API\uff08<code>.egg</code> \u6216 <code>.whl</code> \u6587\u4ef6\u4f4d\u4e8e CARLA \u5b89\u88c5\u76ee\u5f55\u7684 <code>PythonAPI/carla/dist/</code> \u4e0b\uff09\uff1a</p> <pre><code>pip install &lt;CARLA\u76ee\u5f55&gt;/PythonAPI/carla/dist/carla-*.whl\n</code></pre> <p>OpenCV \u7a97\u53e3\u65e0\u54cd\u5e94</p> <p>\u786e\u8ba4 <code>main.py</code> \u5728 CARLA \u6a21\u62df\u5668\u542f\u52a8\u540e\u8fd0\u884c\uff0c\u4e14 CARLA \u672a\u5904\u4e8e\u65e0\u6e32\u67d3\u6a21\u5f0f\uff08<code>-RenderOffScreen</code>\uff09\u3002</p>"}]}