<?xml version="1.0"?>
<!-- 在 Gazebo 中加载简化四旋翼（带前置相机） -->
<launch>
  <arg name="gui" default="false"/>
  <arg name="x" default="0.0"/>
  <arg name="y" default="0.0"/>
  <arg name="z" default="1.0"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find uav_flight_base)/worlds/uav_world.world"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
  </include>

  <param name="robot_description"
         command="cat $(find uav_flight_base)/urdf/uav_simple.urdf"/>

  <node name="spawn_uav" pkg="gazebo_ros" type="spawn_model"
        args="-urdf -param robot_description -model uav -x $(arg x) -y $(arg y) -z $(arg z)"
        output="screen" respawn="false"/>

  <node name="uav_state_monitor" pkg="uav_flight_base" type="uav_state_monitor.py"
        output="screen">
    <param name="odom_topic" value="/uav/odom"/>
    <param name="period" value="1.0"/>
  </node>
</launch>
